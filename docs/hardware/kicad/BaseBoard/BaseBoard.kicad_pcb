	(gr_text "COMPONENT SIDE, upright. Rows A-Z(+A) from the bottom up, columns 22-01 left to right."
		(at 166 102 0)
		(layer "Cmts.User")
		(uuid "8d9b477f-9911-487d-a574-5eef6766f9e3")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "B.Cu = solder bridges between neighbouring pads on the solder side."
		(at 166 103.8 0)
		(layer "Cmts.User")
		(uuid "d2dda553-7e84-4621-b2b9-ad6100a91aa8")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "JP1 = 0R link on the component side, body flat on the board, where 3V3 crosses GND."
		(at 166 105.6 0)
		(layer "Cmts.User")
		(uuid "44911acd-5fcf-4370-ae5e-12835d05a207")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "U1: two 1x15 female headers Y17-Y03 and O17-O03, USB to the left."
		(at 166 107.4 0)
		(layer "Cmts.User")
		(uuid "b50b959e-2ad7-432e-8d64-a3886255240c")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "U2: 1x6 female header E16-E11; BMP280 pins SDO..VCC left to right,"
		(at 166 109.2 0)
		(layer "Cmts.User")
		(uuid "10bc5b49-5c28-4b5d-891a-b404b90df9ae")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "    chip side up, breakout towards the bottom edge."
		(at 166 111 0)
		(layer "Cmts.User")
		(uuid "50304e50-795b-41ff-9e0a-f7d53ff24f47")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "R2 + R1: one 1x4 female header G15-G12 (3V3 SDA | SCL 3V3)."

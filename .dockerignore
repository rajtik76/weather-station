# The image builds the Laravel app only.
firmware/

# Rebuilt inside the image.
/vendor/
/node_modules/
/public/build/
/public/hot

# Credentials come in through the environment, never the image.
.env
auth.json

# Local runtime state; a local build would bake dev caches into the image,
# including a package manifest listing require-dev providers. The
# directories themselves stay: artisan needs them to boot.
/bootstrap/cache/*.php
/storage/logs/*.log
/storage/framework/cache/data/**
/storage/framework/sessions/*
/storage/framework/views/*.php
/storage/debugbar/*.json

# Tooling and editor state.
/.git/
/.github/
/.idea/
/.vscode/
/.ai/
/.agents/
/.claude/
/.codex/
/.junie/
.DS_Store

# Not used at runtime.
/docs/
/tests/
/phpunit.xml
/phpstan.neon
/rector.php

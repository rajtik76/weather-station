auth.json

# Dev caches (incl. a manifest of require-dev providers) must not enter the image; keep the
# directories, artisan needs them to boot.
/bootstrap/cache/*.php
/storage/logs/*.log
/storage/framework/cache/data/**
/storage/framework/sessions/*
/storage/framework/views/*.php
/storage/debugbar/*.json

